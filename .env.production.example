# ==============================================================================
# DevFlow Production Environment Configuration Template
# ==============================================================================
# IMPORTANT:
# - This template contains ONLY safe placeholders and documentation.
# - NEVER commit real production passwords, keys, or database credentials.
# - Provide these values through your cloud platform's secret manager or environment settings.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (Supabase PostgreSQL)
# ------------------------------------------------------------------------------
# Production JDBC URL connecting to your Supabase PostgreSQL instance.
# Ensure 'sslmode=require' is appended for encrypted transport.
DB_URL=jdbc:postgresql://db.<supabase-project-ref>.supabase.co:5432/postgres?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=<strong-production-database-password>

# ------------------------------------------------------------------------------
# 2. JWT Security
# ------------------------------------------------------------------------------
# High-entropy cryptographic secret of at least 256 bits (32+ UTF-8 characters or 64 hex characters).
# Generate securely via: openssl rand -base64 32
JWT_SECRET=<cryptographically-generated-256-bit-minimum-secret>
# Token validity in milliseconds (default: 3600000 = 1 hour)
JWT_EXPIRATION=3600000

# ------------------------------------------------------------------------------
# 3. CORS Configuration
# ------------------------------------------------------------------------------
# Whitelist containing ONLY the exact HTTPS origin of the deployed frontend.
# Do NOT include wildcard '*' (prohibited with allowCredentials=true).
# Example: https://devflow.example.com
CORS_ALLOWED_ORIGINS=https://<your-deployed-frontend-domain>

# ------------------------------------------------------------------------------
# 4. Backend Server Configuration
# ------------------------------------------------------------------------------
# The port the Spring Boot embedded container listens on (cloud platforms may override with $PORT)
SERVER_PORT=8080

# ------------------------------------------------------------------------------
# 5. Frontend Build-Time Configuration (NOT A SECRET)
# ------------------------------------------------------------------------------
# CRITICAL: This variable is consumed during the FRONTEND BUILD STEP (Vite).
# It is embedded statically into client JavaScript and sent by the browser.
# It must point to the public HTTPS URL of the deployed backend API.
# It must NEVER contain any secret.
VITE_API_BASE_URL=https://<your-deployed-backend-domain>
