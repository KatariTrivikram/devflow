# Database Configuration (Supabase PostgreSQL)
DB_URL=jdbc:postgresql://db.xxxxxx.supabase.co:5432/postgres
DB_USERNAME=postgres
DB_PASSWORD=your_super_secret_password

# JWT Security (Minimum 256-bit key for HMAC-SHA256)
JWT_SECRET=replace-with-a-secure-secret-minimum-256-bits
JWT_EXPIRATION=3600000

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80

# Backend Server Configuration
SERVER_PORT=8080

# Frontend Configuration (Browser URL to reach the DevFlow API)
VITE_API_BASE_URL=http://localhost:8080
