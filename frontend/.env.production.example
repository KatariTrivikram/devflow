# ==============================================================================
# DevFlow Frontend Production Environment Template
# ==============================================================================
# NOTE: VITE_API_BASE_URL is a build-time variable, NOT a runtime secret.
# Vite statically inlines this value into the compiled client JavaScript bundle.
# Provide this variable during the frontend build step (e.g. CI or Docker build arg).
# ==============================================================================

# Public HTTPS URL of the deployed DevFlow Spring Boot backend API
VITE_API_BASE_URL=https://<your-deployed-backend-domain>
